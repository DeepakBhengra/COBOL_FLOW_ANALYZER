                   PROGRAM ('WWPSEC')
                   COMMAREA (LNK-BUFFER-AREA)
                   LENGTH (WS-TS-REC-LENGTH)
                   SYNCONRETURN
                   RESP  (WS-EIBRESP)
              END-EXEC
